{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zara.ai/contracts/zara-expert-v1/expert-descriptor.schema.json",
  "title": "ZARA-EXPERT/1 expert descriptor",
  "description": "Structural metadata only. Registration, availability and schema acceptance never grant authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "expert_id",
    "expert_version",
    "package_namespace",
    "manifest_digest",
    "name",
    "description",
    "source_reference",
    "reasoning_kind",
    "operations",
    "applicability_schema",
    "required_observations",
    "required_capabilities",
    "possible_effects",
    "supported_engines",
    "supported_platforms",
    "placement",
    "fallback_policy",
    "delegation_policy",
    "resource_limits",
    "registry_generation",
    "availability",
    "unavailable_reason"
  ],
  "properties": {
    "protocol": {
      "const": "ZARA-EXPERT/1"
    },
    "expert_id": {
      "$ref": "#/$defs/symbol"
    },
    "expert_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
    },
    "package_namespace": {
      "$ref": "#/$defs/token"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
    },
    "description": {
      "type": "string",
      "minLength": 0,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
    },
    "source_reference": {
      "type": "string",
      "pattern": "^source:[a-z0-9][a-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "reasoning_kind": {
      "enum": [
        "symbolic",
        "hybrid",
        "model",
        "service"
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "applicability_schema": {
      "$ref": "#/$defs/schema_ref"
    },
    "required_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "possible_effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "supported_engines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "supported_platforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "runtime_id"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/reference"
        },
        "runtime_id": {
          "$ref": "#/$defs/token"
        },
        "app_id": {
          "$ref": "#/$defs/reference"
        },
        "workspace_id": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "fallback_policy": {
      "enum": [
        "none",
        "explicit"
      ]
    },
    "delegation_policy": {
      "enum": [
        "none",
        "bounded"
      ]
    },
    "resource_limits": {
      "$ref": "#/$defs/limits"
    },
    "registry_generation": {
      "$ref": "#/$defs/generation"
    },
    "availability": {
      "enum": [
        "available",
        "unavailable",
        "incompatible",
        "stale"
      ]
    },
    "unavailable_reason": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
        }
      ]
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?![\\s\\S])"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "symbol": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9._-]{0,63}:[a-z][a-z0-9._-]{0,63}(?:/[a-z0-9][a-z0-9._-]{0,63}){0,7}(?![\\s\\S])"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_ms",
        "max_results",
        "max_output_bytes",
        "max_model_calls"
      ],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_model_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        }
      }
    },
    "schema_ref": {
      "type": "string",
      "maxLength": 135,
      "pattern": "^schema:[a-z0-9][a-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input_schema",
        "output_schema",
        "effects",
        "required_capabilities"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "input_schema": {
          "$ref": "#/$defs/schema_ref"
        },
        "output_schema": {
          "$ref": "#/$defs/schema_ref"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/token"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/token"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reasoning_kind": {
            "const": "symbolic"
          }
        }
      },
      "then": {
        "properties": {
          "fallback_policy": {
            "const": "none"
          },
          "resource_limits": {
            "properties": {
              "max_model_calls": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "availability": {
            "const": "available"
          }
        }
      },
      "then": {
        "properties": {
          "unavailable_reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "unavailable_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
          }
        }
      }
    }
  ]
}
