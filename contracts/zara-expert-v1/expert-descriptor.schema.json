{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zara.ai/contracts/zara-expert-v1/expert-descriptor.schema.json",
  "title": "ZARA-EXPERT/1 ExpertDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "expert_id",
    "expert_version",
    "package_namespace",
    "manifest_digest",
    "name",
    "description",
    "source_reference",
    "reasoning_kind",
    "operations",
    "applicability",
    "required_capabilities",
    "possible_effects",
    "supported_engines",
    "supported_platforms",
    "fallback_policy",
    "delegation_policy",
    "registry_generation",
    "availability"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^ZARA-EXPERT/[1-9][0-9]*$"
    },
    "expert_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[!-~]+$"
    },
    "expert_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
    },
    "package_namespace": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "manifest_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
    },
    "source_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[!-~]+$"
    },
    "reasoning_kind": {"enum": ["symbolic", "hybrid", "model", "service"]},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/operation"}
    },
    "applicability": {"$ref": "#/$defs/applicability"},
    "required_capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
    },
    "possible_effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "none",
          "filesystem_read",
          "filesystem_write",
          "network_egress",
          "process_spawn",
          "model_inference",
          "audio_capture"
        ]
      }
    },
    "supported_engines": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"}
    },
    "supported_platforms": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"}
    },
    "fallback_policy": {"enum": ["fail_closed", "conversational", "none"]},
    "delegation_policy": {"enum": ["never", "children", "any"]},
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000},
        "max_results": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "max_model_calls": {"type": "integer", "minimum": 0, "maximum": 64}
      }
    },
    "registry_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "availability": {
      "enum": ["installed", "available", "ready", "unavailable", "absent"]
    },
    "unavailable_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[!-~]+$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"availability": {"const": "unavailable"}}},
      "then": {"required": ["unavailable_reason"]}
    }
  ],
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "input_schema", "output_schema"],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "input_schema": {"$ref": "#/$defs/fields_schema"},
        "output_schema": {"$ref": "#/$defs/fields_schema"}
      }
    },
    "fields_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/field"}
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "type": {
          "enum": [
            "boolean",
            "integer",
            "number",
            "string",
            "enum",
            "list",
            "object",
            "reference",
            "secret_reference"
          ]
        },
        "required": {"type": "boolean"},
        "enum_values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keywords"],
      "properties": {
        "keywords": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"}
        }
      }
    }
  }
}
