            supportedTypes="SHORT_TEXT EMPTY" isCustomizable="false">
            <BoundingRoundBox x="0" y="0" width="230" height="58" cornerRadius="29" />
            <DefaultProviderPolicy
                primaryProvider="ai.zara.app/ai.zara.wear.complications.OrgNextTodoComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="230" height="58">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" ellipsis="true" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="18" color="#FFEAEAEA">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5">
            <Transform target="angle" value="[HOUR_0_11_MINUTE] * 30" />
            <Line startX="225" startY="232" endX="225" endY="132">
                <Stroke color="#FFFFFFFF" thickness="10" cap="ROUND" />
            </Line>
        </PartDraw>

        <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5">
            <Transform target="angle" value="[MINUTE_SECOND] * 6" />
            <Line startX="225" startY="235" endX="225" endY="88">
                <Stroke color="#FFFFFFFF" thickness="6" cap="ROUND" />
            </Line>
        </PartDraw>

        <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="angle" value="[SECOND] * 6" />
            <Line startX="225" startY="250" endX="225" endY="67">
                <Stroke color="#FFE53935" thickness="3" cap="ROUND" />
            </Line>
        </PartDraw>

        <PartDraw x="0" y="0" width="450" height="450">
            <Ellipse x="218" y="218" width="14" height="14">
                <Fill color="#FFFFFFFF" />
