<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Scene>
        <PartDraw x="0" y="0" width="450" height="450">
            <Ellipse x="5" y="5" width="440" height="440">
                <Fill color="#FF000000" />
            </Ellipse>
            <Arc centerX="225" centerY="225" width="414" height="414"
                startAngle="0" endAngle="359.9">
                <Stroke color="#FF252525" thickness="2" />
            </Arc>
            <Line startX="225" startY="25" endX="225" endY="43">
                <Stroke color="#FFFFFFFF" thickness="3" cap="ROUND" />
            </Line>
            <Line startX="425" startY="225" endX="407" endY="225">
                <Stroke color="#FFFFFFFF" thickness="3" cap="ROUND" />
            </Line>
            <Line startX="225" startY="425" endX="225" endY="407">
