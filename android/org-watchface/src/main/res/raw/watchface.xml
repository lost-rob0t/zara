        <!-- RANGED_VALUE_MIN/MAX are minutes in the current 12-hour dial [0,720]. -->
        <ComplicationSlot slotId="1" displayName="@string/schedule_lane_1"
            x="0" y="0" width="450" height="450"
            supportedTypes="RANGED_VALUE EMPTY" isCustomizable="false">
            <BoundingArc centerX="225" centerY="225" width="410" height="410"
                thickness="12" startAngle="0" endAngle="359.9" />
            <DefaultProviderPolicy
                primaryProvider="ai.zara.app/ai.zara.wear.complications.OrgSchedule1ComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="110" />
                    <Arc centerX="225" centerY="225" width="410" height="410"
                        startAngle="0" endAngle="0">
                        <Transform target="startAngle" value="[COMPLICATION.RANGED_VALUE_MIN] * 0.5" />
                        <Transform target="endAngle" value="[COMPLICATION.RANGED_VALUE_MAX] * 0.5" />
                        <Stroke color="#FFE53935" thickness="10" cap="ROUND" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

