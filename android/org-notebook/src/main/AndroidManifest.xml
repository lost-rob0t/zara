<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="ai.zara.org.permission.ORG_HOME" />
    <uses-permission android:name="ai.zara.permission.EXECUTE_NOTEBOOK" />

    <queries>
        <provider android:authorities="ai.zara.org.sync.home" />
        <package android:name="ai.zara.app" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="Zara Org Notebook"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/org" />
                <data android:mimeType="text/plain" android:pathPattern=".*\\.org" />
            </intent-filter>
        </activity>
    </application>
</manifest>
