{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zara Store companion catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "repo", "packages"],
  "properties": {
    "schema": {
      "const": "ZARA-CATALOG/1"
    },
    "generated_at": {
      "type": "integer",
      "minimum": 0
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fdroid_repo", "revision"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "fdroid_repo": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "packages": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name",
        "version_code",
        "apk_sha256",
        "accepted_signer_sha256",
        "kind",
        "source_repo",
        "source_sha"
      ],
      "properties": {
        "package_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "version_code": {
          "type": "integer",
          "minimum": 1
        },
        "apk_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "accepted_signer_sha256": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "kind": {
          "enum": ["app", "android_plugin", "wear_app", "support"]
        },
        "source_repo": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "source_sha": {
          "$ref": "#/$defs/sourceSha"
        },
        "protocols": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/boundedString"
          }
        },
        "capabilities": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/boundedString"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "android_plugin"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["protocols"],
            "properties": {
              "protocols": {
                "contains": {
                  "type": "string",
                  "pattern": "^ZARA-ANDROID-PLUGIN/"
                },
                "minContains": 1
              }
            }
          }
        }
      ]
    }
  }
}
